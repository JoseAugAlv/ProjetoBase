# ============================================================
# Copie para .env e ajuste. NUNCA versione o .env (tem senhas).
# ============================================================

APP_NAME=ProjetoBase
# development = mostra erros na tela | production = esconde erros (use no servidor!)
APP_ENV=development
# URL completa e pasta do projeto (deixe APP_BASE_PATH vazio se o site estiver na raiz do domínio)
APP_URL=http://localhost/ProjetoBase
APP_BASE_PATH=/ProjetoBase
APP_TIMEZONE=America/Sao_Paulo
# Sessão expira após X segundos sem atividade
SESSION_TIMEOUT=7200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=projetobase
DB_USER=root
DB_PASS=

# Gmail: use uma "senha de app" (https://myaccount.google.com/apppasswords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu-email@gmail.com
MAIL_PASS=sua-senha-de-app
MAIL_FROM=
MAIL_FROM_NAME=ProjetoBase

# Login com Google (opcional; o botão só aparece se os dois estiverem preenchidos)
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
