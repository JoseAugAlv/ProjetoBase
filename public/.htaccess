Options -Indexes
RewriteEngine On

# Arquivo ou pasta existente em public/ (css, js, imagens) -> serve direto
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo o resto -> index.php
RewriteRule ^ index.php [QSA,L]

# Bloqueia arquivos ocultos (.htaccess, .env etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
